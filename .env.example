# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Any model id your key can use - run `tailortex models` to list them
GEMINI_MODEL=gemini-3.1-flash-lite
# Tried in order if the main model is retired/unavailable
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# Optional: default resume for the web app, preferred LaTeX engine
# TAILORTEX_RESUME=my_resume.tex
# TAILORTEX_ENGINE=tectonic
# Hosting publicly? Leave this unset so visitors must bring their own key. Set to 1 only for local use.
# TAILORTEX_USE_SERVER_KEY=1

# Optional second provider - used if Gemini fails (or alone)
# OPENAI_API_KEY=your-openai-key
# OPENAI_MODEL=gpt-4o-mini
